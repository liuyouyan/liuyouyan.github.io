---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

interface Props { post: CollectionEntry<'posts'> }

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.date);
---

<BaseLayout title={`${post.data.title}｜${site.name}`} description={post.data.summary} currentPath="/journal" siteName={site.name}>
  <div class="page-container article-page">
    <a class="back-link" href="/journal">← 返回文章与生活</a>
    <header class="article-header">
      <div class="article-meta"><span>{post.data.placeholder ? '内容示例 · ' : ''}{post.data.category}</span><span>{date}</span></div>
      <h1>{post.data.title}<span class="accent">.</span></h1>
      <p class="summary">{post.data.summary}</p>
      <div class="tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
    </header>
    {post.data.cover && <img class="cover" src={post.data.cover} alt="文章封面" />}
    <div class="article-layout">
      <aside><span class="overline">JOURNAL ENTRY</span><p>一些正在形成的想法。</p></aside>
      <article class="prose"><Content /></article>
    </div>
    <div class="article-end"><a class="text-link" href="/journal">← 返回文章列表</a><a class="text-link" href="/rss.xml">订阅 RSS ↗</a></div>
  </div>
</BaseLayout>

<style>
  .article-page{padding-top:3rem;padding-bottom:7rem}
  .back-link{color:var(--muted);font-size:.86rem;text-decoration:none}
  .back-link:hover{color:var(--accent)}
  .article-header{padding:4.5rem 0 3rem;border-bottom:1px solid var(--line)}
  .article-meta{display:flex;gap:1.5rem;color:var(--accent);font-size:.78rem;letter-spacing:.08em}
  h1{font-size:clamp(3rem,7vw,6rem);letter-spacing:-.07em;line-height:1.14;margin:1.3rem 0 1.4rem;max-width:15ch;font-weight:600}
  .accent{color:var(--accent)}
  .summary{font-size:1.16rem;line-height:1.8;max-width:42rem;color:var(--muted);margin:0}
  .tags{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:3rem}
  .tags span{border:1px solid var(--line);padding:.4rem .7rem;font-size:.75rem;color:var(--muted)}
  .cover{display:block;width:100%;height:auto;max-height:560px;object-fit:cover;margin:2rem 0}
  .article-layout{display:grid;grid-template-columns:13rem minmax(0,1fr);gap:5rem;padding-top:4rem}
  aside p{color:var(--muted);font-size:.86rem;line-height:1.7}
  .prose{max-width:45rem;line-height:2;color:var(--ink);font-size:1.04rem}
  .prose :global(h2){font-size:1.65rem;letter-spacing:-.04em;margin:2.5rem 0 1rem}
  .prose :global(h2:first-child){margin-top:0}
  .prose :global(p),.prose :global(li){color:var(--muted)}
  .prose :global(a){color:var(--accent);text-decoration:underline;text-underline-offset:3px}
  .prose :global(ul),.prose :global(ol){padding-left:1.4rem}
  .prose :global(blockquote){border-left:3px solid var(--accent);margin:2rem 0;padding:.2rem 1.3rem;background:#eeede8}
  .prose :global(img){max-width:100%;height:auto}
  .article-end{border-top:1px solid var(--line);margin-top:4rem;padding-top:2rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
  @media(max-width:720px){.article-header{padding:3rem 0 2rem}.article-layout{grid-template-columns:1fr;gap:1.5rem;padding-top:2.5rem}aside p{display:none}}
</style>

