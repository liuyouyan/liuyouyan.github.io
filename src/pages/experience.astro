---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, education, experiences, honors } from '../data/site';
---

<BaseLayout title={`经历与荣誉｜${site.name}`} description="教育、实习、实践和荣誉记录。" currentPath="/experience" siteName={site.name}>
  <div class="page-container inner-page">
    <header class="page-intro">
      <span class="overline">02 / EXPERIENCE & HONORS</span>
      <h1>一路走来<span class="accent">.</span></h1>
      <p>把重要节点与真实收获放在一起。经历可以是一段时间，成长总发生在细节里。</p>
    </header>

    <div class="section-grid">
      <div class="section-title"><span class="section-number">01</span><h2>教育背景</h2><p>Education</p></div>
      <div class="entries">
        {education.map((item) => (
          <article class="entry">
            <div class="entry-top"><span class="period">{item.period}</span>{item.placeholder && <span class="placeholder">内容示例</span>}</div>
            <h3>{item.school}</h3>
            <p class="subtitle">{item.degree}</p>
            <p class="detail">{item.focus}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="section-grid">
      <div class="section-title"><span class="section-number">02</span><h2>实践与实习</h2><p>Experience</p></div>
      <div class="entries">
        {experiences.map((item) => (
          <article class="entry">
            <div class="entry-top"><span class="period">{item.period}</span><span class="kind">{item.kind}</span>{item.placeholder && <span class="placeholder">内容示例</span>}</div>
            <h3>{item.title}</h3>
            <p class="subtitle">{item.organization}</p>
            <p class="detail">{item.summary}</p>
            {item.highlights.length > 0 && <ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}
          </article>
        ))}
      </div>
    </div>

    <div class="section-grid">
      <div class="section-title"><span class="section-number">03</span><h2>荣誉与获奖</h2><p>Recognition</p></div>
      <div class="entries">
        {honors.map((item) => (
          <article class="entry honor">
            <div class="entry-top"><span class="period">{item.year}</span>{item.placeholder && <span class="placeholder">内容示例</span>}</div>
            <h3>{item.title}</h3>
            <p class="subtitle">{item.issuer}</p>
            <p class="detail">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .inner-page{padding-top:5rem;padding-bottom:8rem}
  .page-intro{padding-bottom:5rem;border-bottom:1px solid var(--line)}
  h1{font-size:clamp(3.2rem,7.5vw,7rem);letter-spacing:-.075em;line-height:1.1;margin:1rem 0 1.4rem;font-weight:600}
  .accent{color:var(--accent)}
  .page-intro p{max-width:37rem;color:var(--muted);line-height:1.9;font-size:1.04rem}
  .section-grid{display:grid;grid-template-columns:17rem minmax(0,1fr);gap:5rem;padding-top:4.5rem}
  .section-title{position:sticky;top:6rem;align-self:start}
  .section-number{font-size:.8rem;color:var(--accent);letter-spacing:.1em}
  h2{font-size:1.6rem;letter-spacing:-.04em;margin:.5rem 0 .25rem}
  .section-title p{font-size:.75rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin:0}
  .entries{border-top:1px solid var(--line)}
  .entry{padding:2rem 0 2.3rem;border-bottom:1px solid var(--line)}
  .entry-top{display:flex;gap:.8rem;align-items:center;flex-wrap:wrap;margin-bottom:1rem}
  .period,.kind,.placeholder{font-size:.75rem;color:var(--muted);letter-spacing:.02em}
  .kind:before{content:'·';margin-right:.8rem}
  .placeholder{color:var(--accent);border:1px solid var(--accent);padding:.15rem .45rem;margin-left:auto}
  h3{font-size:1.4rem;letter-spacing:-.035em;margin:0 0 .3rem;font-weight:600}
  .subtitle{margin:0;color:var(--ink);font-size:.94rem}
  .detail{color:var(--muted);line-height:1.85;max-width:43rem;margin:1.2rem 0 0}
  ul{padding-left:1.2rem;margin:1rem 0 0;color:var(--muted);line-height:1.8}
  li{padding-left:.2rem;margin:.3rem 0}
  @media(max-width:800px){.section-grid{grid-template-columns:1fr;gap:1.3rem;padding-top:3.5rem}.section-title{position:static}.page-intro{padding-bottom:3rem}}
  @media(max-width:640px){.inner-page{padding-top:3rem;padding-bottom:5rem}}
</style>

