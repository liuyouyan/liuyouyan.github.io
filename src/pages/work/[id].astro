---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

interface Props { project: CollectionEntry<'projects'> }

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long' }).format(project.data.date);
---

<BaseLayout title={`${project.data.title}｜${site.name}`} description={project.data.summary} currentPath="/work" siteName={site.name}>
  <div class="page-container article-page">
    <a class="back-link" href="/work" aria-label="返回研究与项目">← 返回研究与项目</a>
    <header class="article-header">
      <div class="article-meta"><span>{project.data.placeholder ? '内容示例 · ' : ''}{project.data.category}</span><span>{project.data.period ?? date}</span></div>
      <h1>{project.data.title}<span class="accent">.</span></h1>
      <p class="summary">{project.data.summary}</p>
      <div class="header-bottom">
        <div class="tags">{project.data.tags.map((tag) => <span>{tag}</span>)}</div>
        {project.data.role && <span class="role">我的角色 / {project.data.role}</span>}
      </div>
    </header>
    {project.data.cover && <img class="cover" src={project.data.cover} alt="项目封面" />}
    <div class="article-layout">
      <aside><span class="overline">PROJECT STORY</span><p>问题、过程、成果与反思。</p></aside>
      <article class="prose"><Content /></article>
    </div>
    {project.data.links.length > 0 && <div class="links"><span class="overline">RELATED LINKS</span>{project.data.links.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>}
    <div class="article-end"><a class="text-link" href="/work">← 查看其他项目</a></div>
  </div>
</BaseLayout>

<style>
  .article-page{padding-top:3rem;padding-bottom:7rem}
  .back-link{color:var(--muted);font-size:.86rem;text-decoration:none}
  .back-link:hover{color:var(--accent)}
  .article-header{padding:4.5rem 0 3rem;border-bottom:1px solid var(--line)}
  .article-meta{display:flex;gap:1.5rem;color:var(--accent);font-size:.78rem;letter-spacing:.08em}
  h1{font-size:clamp(3rem,7vw,6rem);letter-spacing:-.07em;line-height:1.14;margin:1.3rem 0 1.4rem;max-width:13ch;font-weight:600}
  .accent{color:var(--accent)}
  .summary{font-size:1.16rem;line-height:1.8;max-width:42rem;color:var(--muted);margin:0}
  .header-bottom{display:flex;justify-content:space-between;align-items:center;gap:2rem;margin-top:3rem;flex-wrap:wrap}
  .tags{display:flex;gap:.5rem;flex-wrap:wrap}
  .tags span{border:1px solid var(--line);padding:.4rem .7rem;font-size:.75rem;color:var(--muted)}
  .role{font-size:.8rem;color:var(--muted)}
  .cover{display:block;width:100%;height:auto;max-height:560px;object-fit:cover;margin:2rem 0}
  .article-layout{display:grid;grid-template-columns:13rem minmax(0,1fr);gap:5rem;padding-top:4rem}
  aside p{color:var(--muted);font-size:.86rem;line-height:1.7}
  .prose{max-width:46rem;line-height:1.9;color:var(--ink)}
  .prose :global(h2){font-size:1.65rem;letter-spacing:-.04em;margin:2.5rem 0 1rem}
  .prose :global(h2:first-child){margin-top:0}
  .prose :global(p),.prose :global(li){color:var(--muted)}
  .prose :global(a){color:var(--accent);text-decoration:underline;text-underline-offset:3px}
  .prose :global(ul),.prose :global(ol){padding-left:1.4rem}
  .prose :global(blockquote){border-left:3px solid var(--accent);margin:2rem 0;padding:.2rem 1.3rem;background:#eeede8}
  .prose :global(img){max-width:100%;height:auto}
  .links{border-top:1px solid var(--line);margin-top:4rem;padding-top:2rem;display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap}
  .links a{color:var(--accent)}
  .article-end{border-top:1px solid var(--line);margin-top:4rem;padding-top:2rem}
  @media(max-width:720px){.article-header{padding:3rem 0 2rem}.article-layout{grid-template-columns:1fr;gap:1.5rem;padding-top:2.5rem}aside p{display:none}}
</style>

