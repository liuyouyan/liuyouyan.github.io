---
interface Props {
  siteName?: string;
}

const { siteName = '你的名字' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__eyebrow">THE STORY CONTINUES</p>
      <p class="site-footer__title">保持好奇，持续创造。</p>
      <a class="text-link" href="/about/">更多关于我 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="site-footer__bottom">
      <span>© {year} {siteName}</span>
      <span>以热爱与耐心持续更新</span>
      <a href="#top">返回顶部 ↑</a>
    </div>
  </div>
</footer>
