---
interface Props {
  currentPath?: string;
  siteName?: string;
}

const { currentPath = '/', siteName = '你的名字' } = Astro.props;
const navigation = [
  { href: '/', label: '首页' },
  { href: '/work/', label: '研究与项目' },
  { href: '/experience/', label: '经历与荣誉' },
  { href: '/journal/', label: '文章与生活' },
  { href: '/about/', label: '关于' },
];
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href.slice(0, -1));
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-brand" href="/" aria-label={`${siteName}的首页`}>
      <span class="site-brand__mark" aria-hidden="true">✳</span>
      <span class="site-brand__name">{siteName}<span class="site-brand__period">.</span></span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {navigation.map(({ href, label }) => (
        <a href={href} class:list={['site-nav__link', { 'is-active': isActive(href) }]} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>
